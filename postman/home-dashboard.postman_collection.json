  "item": [
    {
      "name": "Auth",
      "description": "Log in once with **Login**; the collection then sends the Bearer token on every request and refreshes it automatically.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Log in with the dashboard user (DASHBOARD_USER / DASHBOARD_PASS). Saves `access_token` (1 h) and `refresh_token` (90 days) into the collection variables.",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"{{device_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"tokens returned\", () => pm.expect(res.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"access_token\", res.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", res.refresh_token);",
                  "pm.collectionVariables.set(\"session_id\", res.session_id);",
                  "pm.collectionVariables.set(\"access_expires_at\", String(Date.now() + res.expires_in * 1000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Swap the refresh token for new tokens. Refresh tokens are single use: the new one is stored; re-sending an old one revokes the session. The collection does this for you before the access token expires.",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"tokens returned\", () => pm.expect(res.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"access_token\", res.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", res.refresh_token);",
                  "pm.collectionVariables.set(\"session_id\", res.session_id);",
                  "pm.collectionVariables.set(\"access_expires_at\", String(Date.now() + res.expires_in * 1000));"
                ]
              }
            }
          ]
        },
