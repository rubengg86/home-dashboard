                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const all = pm.response.json().flatMap((d) => [d, ...(d.children || [])]);",
                  "const sw = all.find((d) => d.switchable);",
                  "if (sw) pm.collectionVariables.set(\"device_id\", sw.id);",
                  "const dim = all.find((d) => d.dimmable);",
