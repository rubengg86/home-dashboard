                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "description": "End this session; the tokens stop working.",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "[\"access_token\", \"refresh_token\", \"session_id\", \"access_expires_at\", \"stream_token\", \"stream_expires_at\"]",
                  "  .forEach((k) => pm.collectionVariables.unset(k));"
                ]
              }
            }
          ]
        }
      ]
    },
