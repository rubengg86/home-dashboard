# Tapo cloud account (used only for the local handshake)
TAPO_USER=your@email.com
TAPO_PASS=your_password

# Optional: comma-separated device IPs (include the H100). Leave empty to use broadcast discovery.
TAPO_HOSTS=

# Polling intervals in seconds
POLL_SECONDS=5
HUB_POLL_SECONDS=1.5
REDISCOVER_SECONDS=300

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# yi-hack cameras: Name=IP (or Name=http://user:pass@IP if you set a web UI password), separated by ;
CAMERAS=Yi camera=192.168.17.250
SNAPSHOT_SECONDS=2
SNAPSHOT_CACHE_SECONDS=1
# Live video (needs ffmpeg: brew install ffmpeg)
LIVE_FPS=10
LIVE_MAX_WIDTH=1280

# Samsung SmartThings (washer/dryer). PATs expire after 24 h: paste a new one here, no restart needed.
SMARTTHINGS_TOKEN=
SMARTTHINGS_POLL_SECONDS=30
SMARTTHINGS_DEVICES=

# SmartThings OAuth (auto-renewing). When CLIENT_ID/SECRET are set they take priority over SMARTTHINGS_TOKEN.
# Create them once with: smartthings apps:create  (OAuth-In App, scope r:devices:*, redirect https://httpbin.org/get)
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=https://httpbin.org/get
SMARTTHINGS_SCOPES=r:devices:*

# Tuya / Smart Life (immersion heater). Device ids + local keys come from devices.json (tinytuya wizard).
TUYA_DEVICES_FILE=devices.json
TUYA_POLL_SECONDS=3
# Switch the heater off if it has been on this long without a boost timer (0 = never)
HEATER_MAX_ON_MINUTES=180
# Price per kWh for the cost figures (0 = hide cost)
ELECTRICITY_PRICE=0
CURRENCY=€
